. 
. // estimate marginal QALYs across a lifetime horizon
. // and the difference in QALYs
. cap drop tvar

. cap range tvar 0 30 100

. jmqaly qaly, at(trt 1) at2(trt 0) qolmodel(2) timevar(tvar)

. log close
