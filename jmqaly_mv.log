
. clear

. // set the seed for reproducibility
. set seed 7254

. // we simulate a dataset with 500 patients
. set obs 500
Number of observations (_N) was 0, now 500.

. // generate an id variable
. gen id = _n

. // generate binary treatment group with 50% assignment probability
. gen trt = runiform()>0.5

. // generate random interecpts and slopes for the longitudinal outcomes
. gen u0 = rnormal(0,0.1)

. gen u1 = rnormal(0,0.01)

. gen u2 = rnormal(0,0.5)

. 
. // simulate survival times from a joint model
. //-> baseline Weibull
. //-> direct effect of treatment on survival if log HR = -0.5
. //-> current value of biomarker 1 influences survival
. //-> current value of biomarker 2 influences survival
. //-> admin. censoring at 10 years
. survsim stime died, hazard(0.15:*1.2:*{t}:^0.2 :*                       ///
>         exp(                                                            ///
>                 -0.2 :* (0.7 :+ u0 :+ (-0.05:+u1 :+ 0.01:*trt):*{t})    ///
>                 :+ 0.2 :* (0.1 :+ u2 :+ (0.1 :- 0.01:*trt):*{t}))       ///
>         )                                                               ///
>         covariates(trt -0.5)                                            ///
>         maxt(10)                                                        //
Warning: 71 survival times were above the upper limit of maxtime()
         They have been set to maxtime()
         You can identify them by _survsim_rc = 3

. 
. // create repeated measures, up to 10 per patient
. expand 10
(4,500 observations created)

. // generate time of observation (annual)
. bys id : gen time = _n-1

. // remove any observations that occur after event/censoring
. drop if time>stime
(2,428 observations deleted)

. 
. // simulate "QOL"
. gen xb1 = 0.7 + u0 + (-0.05+u1 + 0.01*trt) * time 

. gen qol = rnormal(xb1,0.5)

. 
. // simulate "other biomarker"
. gen xb2 = 0.1 + u2 + (0.1 - 0.01*trt) * time 

. gen logpsa = rnormal(xb2,0.5)

. 
. // remove repeat survival times (caused by use of expand)
. bys id (time) : replace stime   = . if _n>1
(2072 real changes made, 2072 to missing)

. bys id (time) : replace died    = . if _n>1
(2,072 real changes made, 2,072 to missing)

. 
. // fit the true model with merlin
. merlin  (stime                                  /// survival times
>                 trt                             /// treatment on survival
>                 M3[id]                  /// current value of y1
>                 M1[id]                  /// current value of y2
>                 , family(rp, df(1) fail(died))  /// Weibull baseline
>                 timevar(stime))                 /// time variable
>         (qol                                    /// QOL measurements
>                 time                            /// fixed effect of time
>                 time#trt                        /// time by treat. interaction
>                 time#M2[id]@1                   /// random effect on time
>                 M1[id]@1                        /// random intercept
>                 , family(gaussian)              /// Gaussian model
>                 timevar(time))                  /// time variable
>         (logpsa                                 /// other biomarker measurements
>                 time                            /// fixed effect of time
>                 time#trt                        /// time by treat. interaction
>                 M3[id]@1                        /// random intercept
>                 , family(gaussian)              /// Gaussian model
>                 timevar(time))                  /// time variable
>                 , covariance(unstructured)      //  VCV of random effects
